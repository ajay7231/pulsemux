# Local: optional. SQLite and a private local encryption key are created in worker-py/data.
# DATABASE_URL=postgresql+psycopg://pulsemux:replace-me@localhost:5432/pulsemux
# PLATFORM_ENV=development

# Deployment: copy to an untracked env file and set all three values.
# Generate encryption key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_SETUP_TOKEN=replace-with-a-long-random-setup-token
POSTGRES_PASSWORD=replace-with-a-long-random-password
PLATFORM_ENCRYPTION_KEYS=replace-with-generated-fernet-key
# Must be an HTTPS origin. The optional Docker "edge" profile uses this for TLS.
# DNS and ports 80/443 must reach the server before enabling that profile.
PUBLIC_BASE_URL=https://voice.your-hospital.example
REDIS_URL=redis://localhost:6379/0

# Legacy simulator/pipeline only. Managed agents use encrypted workspace connections.
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=

# Local clinical RAG: enable only with Python 3.10+ dependencies and ingestion worker.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# RAG_MODEL_CACHE=./model_cache
# RAG_ONNX_THREADS=1
