      "id": 1,
      "title": "Voice-to-Voice Latency (P50 & P95 SLA)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(v2v_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(v2v_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Barge-In Interruption Reaction Time",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(barge_in_latency_seconds_sum[1m]) / rate(barge_in_latency_seconds_count[1m]) * 1000",
          "legendFormat": "Avg Barge-In Reaction (ms)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
